{
	"ci": {
		"collect": {
			"staticDistDir": "./apps/web/dist",
			"numberOfRuns": 1
		},
		"assert": {
			"assertions": {
				"categories:pwa": ["error", { "minScore": 0.9 }],
				"is-on-https": "off",
				"redirects-http": "off"
			}
		},
		"upload": {
			"target": "temporary-public-storage"
		}
	}
}
