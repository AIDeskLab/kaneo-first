# TruffleHog path exclusions (regex, one per line).
# These paths contain only placeholder / non-secret credentials:
# - Compose files, docs, charts, and tests reference example credentials like
#   postgres:postgres, ci-only-password, user:pass@example.test.
#
# NOTE: keep this list narrow. Do not add source directories (apps/, packages/).
^README\.md$
^compose(\.[a-z-]+)?\.yml$
^scripts/ci/
^charts/
^tests/
^apps/docs/
^\.cursor/rules/deployment-devops\.mdc$
^CONTRIBUTORS\.svg$
^scripts/security/file-secrets\.test\.mjs$
^apps/api/src/gitlab-integration/index\.ts$
^apps/api/src/gitlab-integration/controllers/create-gitlab-integration\.ts$
^apps/api/src/gitlab-integration/utils/normalize-input\.ts$
^apps/api/src/plugins/gitlab/webhooks/issue-opened\.ts$
^apps/api/src/plugins/gitlab/webhooks/issue-updated\.ts$
^apps/web/src/components/project/gitlab-integration/
^apps/web/src/components/project/gitlab-integration-settings\.tsx$
^apps/web/src/components/project/gitlab-project-browser-modal\.tsx$
^apps/web/src/components/project/integrations/use-integration-statuses\.ts$
^apps/web/src/query-client/index\.test\.ts$
^i18n/.*\.json$
^\.trufflehog-exclude$
